*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# Vendored upstream runtimes. Pinned in native/VERSIONS and fetched by
# tools/fetch-native.sh — checking in ~400 MB of someone else's source would
# make every clone of this repo pay for it.
native/llama.cpp/
native/whisper.cpp/
native/stable-diffusion.cpp/
native/espeak-ng/
native/quickjs/

# No longer fetched — the app is CPU-only. Still ignored so an older checkout
# does not suddenly offer 200 MB of Khronos source and Qualcomm DSP images for
# staging.
native/OpenCL-Headers/
native/OpenCL-ICD-Loader/
native/hexagon/

# The staged espeak-ng data tables under app/src/main/assets/ are NOT ignored:
# they are compiled artifacts that need the espeak-ng binary to produce, which a
# cross-compile to Android never builds. See tools/stage-espeak-data.py.

# Kotlin compiler session state — transient build output, never source.
.kotlin/

# The release signing key and its passwords. A committed keystore is a
# published one: anyone with it can ship an update that Android accepts as
# this app. build.gradle.kts falls back to an unsigned release when neither
# the file nor the environment supplies a key, so a fresh clone still builds.
keystore.properties
*.jks
*.keystore
