<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- SPEC 13 — all model files and generated artifacts are user-accessible.
         Nothing lives in a private opaque store. -->
    <external-files-path name="models" path="models/" />
    <external-files-path name="gallery" path="gallery/" />
    <external-files-path name="transcripts" path="transcripts/" />
    <external-files-path name="attachments" path="attachments/" />
    <external-files-path name="exports" path="exports/" />
    <cache-path name="downloads" path="downloads/" />
    <!-- The proxy's own certificate, staged so it can be sent to the machine
         that has to trust it. A public key, and it leaves only when asked. -->
    <cache-path name="certificates" path="certificates/" />
</paths>
