<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SPEC 13 — network is used only for the HF API and downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- SPEC 17.2 Channel A only: in-app runtime bundle install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".OnDeviceApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnDeviceAI"
        tools:targetApi="34">

        <!--
            The GPU, declared.

            An app's linker namespace permits /data and nothing else, so a
            library under /vendor is unreachable however it is asked for:
            linking against libOpenCL.so failed at load, and dlopening the
            Adreno driver by path failed with the permitted_paths spelled out
            in the log. Shipping our own copy of the Khronos loader only moved
            the failure — it could link, and then had no driver it was allowed
            to open.

            This is the declaration Android added in 11 for exactly that: a
            vendor-provided native library the app depends on, which the
            platform then exposes to its namespace. required="false" because
            most devices have no OpenCL at all and none of them should fail to
            install over a GPU backend that degrades to the CPU.
        -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <!--
            And the same wall again, one processor over. The Hexagon backend
            reaches the NPU through fastRPC, which it opens by name at runtime —
            `dlopen("libcdsprpc.so")` in htp-drv.cpp — and that file lives in
            /vendor/lib64 beside libOpenCL.so, on the same
            /vendor/etc/public.libraries.txt and behind the same namespace.

            Without this line ggml registered OpenCL and CPU and simply never
            mentioned the NPU: the registration catches its own failure and
            returns nothing, so the symptom is a missing device rather than an
            error. required="false" for the same reason as above — most phones
            have no DSP an app may talk to, and none of them should fail to
            install over a backend that was never going to register.
        -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OnDeviceAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- SPEC 4.5 / 6 — screenshot and audio share targets. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- SPEC 3.4 — downloads survive app kill. -->
        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- SPEC 2.1 — inference host; owns memory-pressure negotiation. -->
        <service
            android:name=".engine.InferenceService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on-device model inference requested by the user" />
        </service>

        <receiver
            android:name=".data.download.BootSweepReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
