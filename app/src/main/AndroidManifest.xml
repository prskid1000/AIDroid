<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SPEC 13 — network is used only for the HF API and downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        A workflow that starts itself at a chosen time.

        Exact rather than inexact, and the reason is not precision: every run
        needs a foreground service, Android 12 and later forbid starting one from
        the background, and an app woken by an *exact* alarm is explicitly exempt
        from that. An inexact alarm wakes us with no way to do the one thing we
        were woken for.

        Denied by default from Android 13 onward, so it is asked for through
        Settings and refusal is a supported state rather than a broken feature —
        see Scheduler.armInexact, which falls back to a notification and a tap.
        USE_EXACT_ALARM is the version that needs no prompt and is restricted by
        Play to alarm clocks and calendars, which this is not.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!--
        A scheduled run needs a foreground service, and an app woken by an exact
        alarm is exempt from the rule forbidding one from the background — which
        is the whole reason scheduling takes this shape rather than WorkManager's.

        Denied by default from Android 13 onward, and this app targets 35, so it
        is asked for rather than assumed. USE_EXACT_ALARM, which is granted
        automatically, is restricted by Play to alarm clocks and calendars and
        this app would not qualify. Refusal is not fatal: see ScheduleReceiver,
        which falls back to a notification and a tap.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- SPEC 17.2 Channel A only: in-app runtime bundle install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        What a Send step is allowed to see.

        Since Android 11, resolveActivity returns null for any app not declared
        visible here, so without this the target picker would be empty and a
        step aimed at a named app would look like it had been aimed at nothing.
        QUERY_ALL_PACKAGES is the alternative and is a restricted Play permission
        that nothing in this app could justify.

        Declared as a capability rather than a list of package names: the picker
        is "every app that can receive this type", asked of the system, so a mail
        client installed tomorrow appears without an app update — the same stance
        SPEC 1.1 takes about models and 1.3 about metadata.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".OnDeviceApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnDeviceAI"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OnDeviceAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                The two SEND filters that used to be here are gone, and their
                absence is the fix rather than a removal of one. Nothing in this
                app ever read EXTRA_STREAM, so sharing a screenshot in opened the
                app on whatever tab it was last on and dropped the picture — a
                share target that silently does nothing, which is the failure
                SPEC 1.2 exists to forbid. They now live on TriggerActivity,
                which reads what it is given.
            -->
        </activity>

        <!--
            SPEC 4.5 / 6 — where anything shared into this app arrives.

            Its own activity and not a filter on MainActivity, for three
            reasons. MainActivity is singleTask deliberately, so that a
            notification tap reuses the instance instead of rebuilding it and
            killing the generation it holds; a share landing in that same task
            is the same hazard from another direction. ACTION_PROCESS_TEXT has
            to return a result to its caller, which the app's main task must not
            be doing. And taskAffinity="" keeps a share from leaving a second
            card in recents — the reasoning already written on
            OAuthCallbackActivity.

            */* puts this app in every share sheet on the device. The narrower
            alternative is a manifest listing types, which cannot follow what the
            graphs actually take; the answer is to accept everything and refuse
            well, which TriggerActivity does by name.
        -->
        <activity
            android:name=".workflow.TriggerActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:label="@string/trigger_label"
            android:theme="@style/Theme.OnDeviceAI.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!--
                The floating toolbar over selected text, in any app. Select,
                tap, and the workflow runs on it without a share sheet at all.
            -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- For automation apps: ai.ondevice://workflow/<id> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ai.ondevice" android:host="workflow" />
            </intent-filter>

            <!--
                The share-target declarations the published shortcuts match
                against. No chooser_target_service meta-data beside it: that is
                the API 21-28 back-compat shim, and minSdk here is 31.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Where a parked hand-off's notification lands.

            Since Android 12 a notification may not trampoline an activity start
            through a receiver or a service, so the pending intent has to be a
            getActivity and this is what it gets. It draws nothing.
        -->
        <activity
            android:name=".workflow.HandoffActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          Where an MCP sign-in comes back to.

          A custom scheme, not an https App Link: an App Link has to be claimed
          by publishing assetlinks.json on a domain, and this project has no
          server anywhere to publish it on. The trade is that another app could
          register the same scheme, which is exactly what PKCE is for — the
          code alone is worth nothing without the verifier, and that never
          leaves this process.

          No affinity and excluded from recents so it never shows up as a
          second card; it draws nothing and finishes immediately.
        -->
        <activity
            android:name=".tools.OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ai.ondevice" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- SPEC 3.4 — downloads survive app kill. -->
        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- SPEC 2.1 — inference host; owns memory-pressure negotiation. -->
        <service
            android:name=".engine.InferenceService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on-device model inference requested by the user" />
        </service>

        <receiver
            android:name=".data.download.BootSweepReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Where a scheduled run begins, and where every armed alarm is rebuilt.

            Alarms do not survive a reboot, and a schedule is stored as a
            wall-clock time — "every morning at seven" has to stay seven o'clock
            across a flight — so moving the clock or the zone invalidates every
            one of them. All three of these broadcasts are themselves exempt from
            the rule forbidding a foreground-service start from the background,
            which is what makes re-arming from here safe.
        -->
        <receiver
            android:name=".workflow.ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    
        <!--
            Its own process, so killing the main one does not kill the thing
            doing the killing. See RestartActivity: an activity start from a
            dead process is dropped by the background-launch rules, so the
            launch has to happen from something still in the foreground.
        -->
        <activity
            android:name=".RestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
</application>
</manifest>
